# AgentBuilder 基础设施环境变量样例
# 复制为 .env 后按需修改；docker compose 与本地开发（T0.2 起）统一从这里读取配置。
#
# HOST/PORT 说明：这里的 *_HOST/*_PORT 是"宿主机本地开发"视角的默认值（localhost + 宿主机映射端口），
# 供本地直接运行 backend-api/agent-runner 等进程时连接 docker compose 拉起的 postgres/redis/minio。
# 当这些服务本身作为 compose service 运行时（backend-api 容器等），docker-compose.yml 会在对应 service
# 的 environment 里用 compose 服务名 + 组件标准端口（如 postgres:5432）覆盖这里的值，不依赖 .env 里的这几项。

# ---------- Postgres ----------
POSTGRES_USER=agentbuilder
POSTGRES_PASSWORD=agentbuilder_dev_password
POSTGRES_DB=agentbuilder
# 本机 5432 已被其他项目占用，宿主机侧映射改用 5442（容器内部仍是标准 5432）
POSTGRES_PORT=5442
POSTGRES_HOST=localhost

# ---------- Redis ----------
REDIS_PASSWORD=agentbuilder_dev_password
# 本机 6379 已被其他项目占用，宿主机侧映射改用 6389（容器内部仍是标准 6379）
REDIS_PORT=6389
REDIS_HOST=localhost

# ---------- MinIO ----------
MINIO_ROOT_USER=agentbuilder
MINIO_ROOT_PASSWORD=agentbuilder_dev_password
# S3 API 端口（本机 9000 已被其他项目占用，宿主机侧映射改用 9010，容器内部仍是标准 9000）
MINIO_PORT=9010
# 管理控制台端口（宿主机侧映射改用 9011，容器内部仍是标准 9001）
MINIO_CONSOLE_PORT=9011
MINIO_HOST=localhost
# 两个 bucket：skill 包一个，workspace 快照（仓库快照 + 输出快照，用 key 前缀区分）一个
# 决策记录见 docs/TASKS.md T0.1
MINIO_BUCKET_SKILLS=agent-builder-skills
MINIO_BUCKET_WORKSPACES=agent-builder-workspaces

# ---------- Backend API ----------
BACKEND_API_PORT=8080
LOG_LEVEL=INFO
# 前端页面的源，逗号分隔；本地开发默认放行 Vite dev server 的 5173
CORS_ALLOW_ORIGINS=http://localhost:5173
# 简单登录鉴权（非多租户）：单一管理员账号密码，生产环境务必修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# 登录 token 有效期（秒），默认 7 天
AUTH_TOKEN_TTL_SECONDS=604800
# 登录 token 存 Redis 用的 db index：db 0/1 是 agent-runner 的 Celery broker/result backend，
# db 2 预留给 T4.2 Agent 互斥锁，这里单独用 db 3 避免 key 空间混用
AUTH_REDIS_DB=3

# ---------- Agent Runner ----------
# 流式执行 HTTP 服务端口。compose 里不对外发布宿主机端口（TECH_DESIGN：Backend API 通过 compose 服务名 DNS
# 轮询直连各副本，--scale agent-runner=N 时多副本不能抢占同一个宿主机端口），本地单进程调试时才会用到这个端口。
AGENT_RUNNER_HTTP_PORT=8100
# Celery broker/result backend 各用独立 redis db index，避免与后续 T4.2 Agent 互斥锁（预留 db 2）混用 key 空间
CELERY_BROKER_DB=0
CELERY_RESULT_DB=1
# 本地临时磁盘缓存目录（clone 仓库/合并快照用，本任务只建目录不写业务数据）；本地开发用相对路径，
# 容器内由 docker-compose.yml 覆盖成绝对路径并挂到具名 volume 上（见 T0.3 决策记录）
RUNNER_LOCAL_CACHE_DIR=./.cache/agent-runner

# ---------- Frontend ----------
FRONTEND_PORT=5173
# 浏览器发起请求永远走宿主机可达地址，不是 compose 服务名（fetch 是在用户浏览器里执行的，不在 compose 网络内），
# 所以固定用 localhost + Backend API 的宿主机端口；改了上面的 BACKEND_API_PORT 记得同步改这里
VITE_API_BASE_URL=http://localhost:8080
